# Obsidian vault path (absolute path to the vault root on your machine)
VAULT_PATH=/path/to/your/obsidian/vault

# Subfolder inside the vault that contains blog posts
VAULT_POSTS_FOLDER=50-Publish

# Cloudflare R2 image storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=blog-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Public CDN base URL for uploaded images
CDN_BASE_URL=https://pub-example.r2.dev

# Cloudflare API token, if you deploy through Cloudflare tooling
CF_API_TOKEN=your_cloudflare_api_token
