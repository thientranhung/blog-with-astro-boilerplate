---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import Backlinks from "@/components/Backlinks.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import EditPost from "../../../posts/[...slug]/_components/EditPost.astro";
import ShareLinks from "../../../posts/[...slug]/_components/ShareLinks.astro";
import BackButton from "../../../posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "../../../posts/[...slug]/_components/BackToTopButton.astro";
import AdjacentPostNav from "../../../posts/[...slug]/_components/AdjacentPostNav.astro";
import config from "@/config";
import translationsData from "@/content/generated/translations.json";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.lang === "en");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      prevPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
      nextPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? "en";

const {
  title,
  description,
  ogImage: initOgImage,
  cover,
  canonical: canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  translationKey,
} = post.data;

// Build locale→URL map from translations.json for language switcher and hreflang
const allTranslations = translationKey
  ? ((translationsData as Record<string, Record<string, string>>)[
      translationKey
    ] ?? {})
  : {};
const alternateUrls: Partial<Record<string, string>> = {};
for (const [lang, slug] of Object.entries(allTranslations)) {
  alternateUrls[lang] = new URL(
    getPostUrl(slug, undefined, lang),
    Astro.site ?? Astro.url
  ).href;
}
// Ensure current locale is always present (for hreflang self-reference)
if (!alternateUrls[locale]) {
  const currentSlug = getPostSlug(post.id, post.filePath).replace(/^\//, "");
  alternateUrls[locale] = new URL(
    getPostUrl(currentSlug, undefined, locale),
    Astro.site ?? Astro.url
  ).href;
}
// Relative URLs for the header lang switcher (navigation)
const headerAlternateUrls: Partial<Record<string, string>> = {};
for (const [lang, slug] of Object.entries(allTranslations)) {
  headerAlternateUrls[lang] = getPostUrl(slug, undefined, lang);
}

const postSlug = getPostSlug(post.id, post.filePath).replace(/^\//, "");

const { Content } = await render(post);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

// Fallback to cover (featured_image from Obsidian sync pipeline)
if (!ogImageUrl && cover) {
  ogImageUrl = cover;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  hreflangs={alternateUrls}
>
  <Header alternateUrls={headerAlternateUrls} />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        |
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <ShareLinks />

    <Backlinks slug={postSlug} />

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  async function renderMermaid() {
    const pres = document.querySelectorAll('pre[data-language="mermaid"]');
    if (pres.length === 0) return;
    const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    mermaid.initialize({ startOnLoad: false, theme: isDark ? "dark" : "default" });
    for (const pre of pres) {
      const target = pre.parentElement?.style.position === "relative" ? pre.parentElement : pre;
      const source = pre.querySelector("code")?.innerText ?? "";
      const { svg } = await mermaid.render("mg-" + Math.random().toString(36).slice(2), source);
      const div = document.createElement("div");
      div.className = "mermaid-diagram my-6 overflow-x-auto";
      div.innerHTML = svg;
      target.replaceWith(div);
    }
  }
  renderMermaid();
</script>
